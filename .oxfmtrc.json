{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "proseWrap": "never",
  "embeddedLanguageFormatting": "off",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": ["pnpm-lock.yaml"]
}
